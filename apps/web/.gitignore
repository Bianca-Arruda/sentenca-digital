# Arquivos gerados automaticamente pelo TypeScript e Next.js
next-env.d.ts
*.tsbuildinfo

# Logs de debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Arquivos do sistema operacional e editores (VS Code, Windows, Mac)
.DS_Store
Thumbs.db
.vscode/
.idea/
